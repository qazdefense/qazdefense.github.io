<a class="ntile" href="/news/<%= n.slug %>">
  <% if (n.cover) { %><div class="ntile-cover"><img src="<%= n.cover %>" alt="" loading="lazy"></div><% } %>
  <time datetime="<%= n.date %>"><%= formatDate(n.date) %></time>
  <h3><%= n.title %></h3>
  <span class="ntile-more">Читать <%- include('icon', { name: 'arrow' }) %></span>
</a>
