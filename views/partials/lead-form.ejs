<% if (typeof isStatic !== 'undefined' && isStatic) { %>
  <div class="static-contact">
    <p>Напишите нам, ответим и уточним задачу.</p>
    <div class="static-buttons">
      <% channels.forEach(function (c) { if (!c.href) return; %>
        <a class="sbtn <%= c.cls %>" href="<%= c.href %>"<% if (c.href.indexOf('http') === 0) { %> target="_blank" rel="noopener"<% } %>><%= c.label %></a>
      <% }) %>
    </div>
    <% if (!channels.some(function (c) { return c.href; })) { %><p class="muted">Контакты скоро появятся здесь.</p><% } %>
  </div>
<% } else { %>
<% if (sent) { %>
  <div class="form-done" role="status">
    <h3>Заявка отправлена</h3>
    <p>Мы свяжемся с вами в рабочее время, чтобы уточнить задачу и договориться о времени.</p>
  </div>
<% } else { %>
  <form class="lead-form" method="post" action="<%= action %>#form" novalidate>
    <div class="field <%= errors.name ? 'has-error' : '' %>">
      <label for="f-name">Имя</label>
      <input id="f-name" name="name" autocomplete="name" value="<%= values.name || '' %>" required>
      <% if (errors.name) { %><span class="err"><%= errors.name %></span><% } %>
    </div>
    <div class="field <%= errors.phone ? 'has-error' : '' %>">
      <label for="f-phone">Телефон или WhatsApp</label>
      <input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder="+7" value="<%= values.phone || '' %>" required>
      <% if (errors.phone) { %><span class="err"><%= errors.phone %></span><% } %>
    </div>
    <div class="field">
      <label for="f-company">Компания и город</label>
      <input id="f-company" name="company" autocomplete="organization" value="<%= values.company || '' %>">
    </div>
    <div class="field">
      <label for="f-message"><%= messageLabel %></label>
      <textarea id="f-message" name="message" rows="4"><%= values.message || '' %></textarea>
    </div>
    <div class="hp" aria-hidden="true"><label>Сайт <input name="website" tabindex="-1" autocomplete="off"></label></div>
    <button class="btn btn-primary btn-block" type="submit"><%= submitLabel %></button>
    <p class="form-note">Отправляя заявку, вы соглашаетесь на обработку контактных данных для связи с вами.</p>
  </form>
<% } %>

<% } %>
