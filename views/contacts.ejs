<%- include('partials/head') %>
<%
  var digits = String(contacts.phone || '').replace(/[^\d+]/g, '');
  var hasPhone = digits.replace('+', '').length >= 10;
  var wa = String(contacts.whatsapp || '').replace(/\D/g, '') || (hasPhone ? digits.replace('+', '') : '');
  var tg = String(contacts.telegram || '');
  var hasTg = /^@?[A-Za-z0-9_]{5,}$/.test(tg);
  var hasMail = /@.+\./.test(String(contacts.email || ''));
  var channels = [
    { cls: 'ch-wa', label: 'WhatsApp', value: contacts.phone, href: wa ? 'https://wa.me/' + wa : '' },
    { cls: 'ch-tg', label: 'Telegram', value: contacts.telegram, href: hasTg ? 'https://t.me/' + tg.replace('@', '') : '' },
    { cls: 'ch-tel', label: 'Телефон', value: contacts.phone, href: hasPhone ? 'tel:' + digits : '' },
    { cls: 'ch-mail', label: 'E-mail', value: contacts.email, href: hasMail ? 'mailto:' + contacts.email : '' },
  ];
%>
<%- include('partials/page-hero', { heading: 'Контакты', crumbs: [{ label: 'Контакты' }], lead: 'Работаем по всему Казахстану. Напишите удобным способом или оставьте заявку.' }) %>

<section class="pg">
  <div class="container contacts2">
    <div class="channels">
      <% channels.forEach(function (c) { var tag = c.href ? 'a' : 'div'; %>
        <<%= tag %> class="channel <%= c.cls %>"<% if (c.href) { %> href="<%= c.href %>"<% if (c.href.indexOf('http') === 0) { %> target="_blank" rel="noopener"<% } %><% } %>>
          <span class="channel-label"><%= c.label %></span>
          <strong class="channel-value"><%= c.value %></strong>
          <% if (c.href) { %><span class="tile-go" aria-hidden="true"><%- include('partials/icon', { name: 'arrow' }) %></span><% } %>
        </<%= tag %>>
      <% }) %>
      <div class="channel ch-geo">
        <span class="channel-label">География</span>
        <strong class="channel-value"><%= contacts.geography %></strong>
      </div>
    </div>
    <div class="form-card form-card-xl" id="form">
      <h2>Оставить заявку</h2>
      <p class="muted">Опишите задачу в двух словах, остальное уточним по телефону.</p>
      <%- include('partials/lead-form', { action: '/contacts', messageLabel: 'Задача', submitLabel: 'Отправить заявку' }) %>
    </div>
  </div>
</section>
<%- include('partials/foot') %>
