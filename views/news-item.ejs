<%- include('partials/head') %>
<%- include('partials/page-hero', { heading: item.title, lead: item.excerpt, crumbs: [{ label: 'Новости', href: '/news' }, { label: formatDate(item.date) }] }) %>
<section class="section section-tight">
  <div class="container narrow">
    <% if (item.cover) { %><div class="case-hero-img"><img src="<%= item.cover %>" alt=""></div><% } %>
    <div class="prose prose-lg"><%- md(item.body) %></div>
  </div>
</section>
<% if (more.length) { %>
<section class="section section-tint section-tight">
  <div class="container">
    <div class="section-head"><div><h2>Ещё новости</h2></div><a class="link-arrow" href="/news">Все новости</a></div>
    <div class="proj-grid"><% more.forEach(function (n) { %><%- include('partials/news-card', { n: n }) %><% }) %></div>
  </div>
</section>
<% } %>
<%- include('partials/foot') %>
