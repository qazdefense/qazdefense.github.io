<%- include('partials/head') %>
<%
  var tagsHtml = '';
  if (item.industry_name) tagsHtml += '<a class="tag tag-ind" href="/cases?industry=' + item.industry_slug + '">' + escapeFn(item.industry_name) + '</a>';
  item.directions.forEach(function (d) { tagsHtml += '<a class="tag" href="/cases?direction=' + d + '">' + escapeFn(dirName(d)) + '</a>'; });
%>
<%- include('partials/page-hero', { heading: item.title, lead: item.summary, crumbs: [{ label: 'Кейсы', href: '/cases' }, { label: item.title }], tagsHtml: tagsHtml }) %>

<section class="section section-tight">
  <div class="container case-layout">
    <div class="case-main">
      <% if (item.cover) { %><div class="case-hero-img"><img src="<%= item.cover %>" alt=""></div><% } %>
      <div class="tsr">
        <article class="tsr-block"><span class="tsr-label">Задача</span><div class="prose"><%- md(item.task) %></div></article>
        <article class="tsr-block"><span class="tsr-label">Решение</span><div class="prose"><%- md(item.solution) %></div></article>
        <article class="tsr-block tsr-result"><span class="tsr-label">Результат</span><div class="prose"><%- md(item.result) %></div></article>
      </div>
      <% if (item.gallery.length) { %>
        <h2 class="h-sm">Материалы проекта</h2>
        <div class="gallery" data-gallery>
          <% item.gallery.forEach(function (g) { %><a href="<%= g %>" class="gallery-item"><img src="<%= g %>" alt="" loading="lazy"></a><% }) %>
        </div>
      <% } %>
    </div>
    <aside class="case-side">
      <div class="side-card">
        <dl class="facts">
          <% if (item.client) { %><div><dt>Клиент</dt><dd><%= item.client %></dd></div><% } %>
          <% if (item.industry_name) { %><div><dt>Отрасль</dt><dd><%= item.industry_name %></dd></div><% } %>
          <% if (item.directions.length) { %><div><dt>Направления</dt><dd><%= item.directions.map(dirName).join(', ') %></dd></div><% } %>
          <% if (item.solutions.length) { %><div><dt>Использованные решения</dt><dd><div class="chips"><% item.solutions.forEach(function (s) { %><span class="chip"><%= s %></span><% }) %></div></dd></div><% } %>
          <% if (item.result_line) { %><div><dt>Итог</dt><dd class="result">→ <%= item.result_line %></dd></div><% } %>
        </dl>
      </div>
      <div class="side-card side-cta">
        <h3>Похожая задача?</h3>
        <p>Обсудим за 15 минут и предложим формат работы.</p>
        <a class="btn btn-primary btn-block" href="/contacts#form">Обсудить задачу</a>
      </div>
    </aside>
  </div>
</section>

<% if (more.length) { %>
<section class="section section-tint section-tight">
  <div class="container">
    <div class="section-head"><div><h2>Другие кейсы</h2></div><a class="link-arrow" href="/cases">Все кейсы</a></div>
    <div class="proj-grid"><% more.forEach(function (c) { %><%- include('partials/proj-card', { c: c }) %><% }) %></div>
  </div>
</section>
<% } %>
<%- include('partials/foot') %>
