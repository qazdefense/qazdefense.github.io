<%- include('_head', { bare: true }) %>
<div class="a-login">
  <form method="post" action="/admin/login" class="a-card">
    <div class="a-logo a-logo-dark"><img src="/img/logo.svg" alt="" width="30" height="26">QazDefense</div>
    <h1>Вход в админку</h1>
    <% if (error) { %><div class="a-error"><%= error %></div><% } %>
    <label>Логин<input name="login" autocomplete="username" required autofocus></label>
    <label>Пароль<input name="password" type="password" autocomplete="current-password" required></label>
    <button class="a-btn a-btn-primary" type="submit">Войти</button>
  </form>
</div>
<%- include('_foot', { bare: true }) %>
