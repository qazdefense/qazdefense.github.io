<%- include('_head') %>
<% var action = item.id ? '/admin/news/' + item.id : '/admin/news/new'; %>
<div class="a-top">
  <div><a class="a-back" href="/admin/news">← Новости</a><h1><%= item.id ? item.title : 'Новая новость' %></h1></div>
  <% if (item.id && item.status === 'published') { %><a class="a-btn" href="/news/<%= item.slug %>" target="_blank" rel="noopener">Открыть на сайте ↗</a><% } %>
</div>
<% if (error) { %><div class="a-error"><%= error %></div><% } %>

<form method="post" action="<%= action %>" enctype="multipart/form-data" class="a-form">
  <div class="a-form-main">
    <div class="a-card">
      <label>Заголовок *<input name="title" value="<%= item.title || '' %>" required></label>
      <label>Анонс <span class="a-hint">для списка новостей</span><textarea name="excerpt" rows="2"><%= item.excerpt || '' %></textarea></label>
      <label>Текст <span class="a-hint">Markdown</span><textarea name="body" rows="14"><%= item.body || '' %></textarea></label>
    </div>
  </div>
  <div class="a-form-side">
    <div class="a-card a-sticky">
      <span class="a-label">Статус</span>
      <div class="a-seg">
        <label><input type="radio" name="status" value="draft" <%= item.status !== 'published' ? 'checked' : '' %>><span>Черновик</span></label>
        <label><input type="radio" name="status" value="published" <%= item.status === 'published' ? 'checked' : '' %>><span>Опубликована</span></label>
      </div>
      <button class="a-btn a-btn-primary a-block" type="submit">Сохранить</button>
    </div>
    <div class="a-card">
      <label>Дата<input type="date" name="date" value="<%= item.date || '' %>"></label>
      <span class="a-label">Обложка</span>
      <% if (item.cover) { %>
        <div class="a-imgs"><figure><img src="<%= item.cover %>" alt=""><label class="a-check"><input type="checkbox" name="remove_cover" value="1"> удалить</label></figure></div>
      <% } %>
      <input type="file" name="cover_file" accept="image/jpeg,image/png,image/webp" data-preview="pv-cover">
      <div class="a-imgs a-preview" id="pv-cover"></div>
      <label>Адрес страницы <span class="a-hint">создаётся сам</span><input name="slug" value="<%= item.slug || '' %>"></label>
    </div>
  </div>
</form>
<% if (item.id) { %>
  <form method="post" action="/admin/news/<%= item.id %>/delete" class="a-danger" data-confirm="Удалить новость без возможности восстановления?">
    <button type="submit" class="a-btn a-btn-danger">Удалить новость</button>
  </form>
<% } %>
<%- include('_foot') %>
