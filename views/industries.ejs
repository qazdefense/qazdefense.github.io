<%- include('partials/head') %>
<%- include('partials/page-hero', { heading: 'Отраслевые решения', crumbs: [{ label: 'Отрасли' }], lead: 'Подбираем решение под отрасль: конфигурацию учёта, оборудование и интеграции.' }) %>
<% var tones = ['t-web', 't-1c', 't-it', 't-ai', 't-design']; %>
<section class="pg">
  <div class="container">
    <div class="ind-tiles">
      <% industrySolutions.forEach(function (s, i) {
           var ind = industries.find(function (x) { return x.name === s.caseIndustry; }); %>
        <a class="ctile ind-tile <%= tones[i % tones.length] %>" href="<%= ind ? '/cases?industry=' + ind.slug : '/cases' %>">
          <div class="ctile-tags"><span><%= s.config %></span></div>
          <h3><%= s.name %></h3>
          <p class="ind-what"><%= s.what %></p>
          <div class="ctile-result"><span class="ctile-arrow">→</span><span><%= s.result %></span></div>
          <span class="tile-go" aria-hidden="true"><%- include('partials/icon', { name: 'arrow' }) %></span>
        </a>
      <% }) %>
      <div class="ind-more">
        <h3>Также работаем</h3>
        <div class="chip-row"><% otherIndustries.forEach(function (x) { %><span><%= x %></span><% }) %></div>
        <a class="btn btn-cta" href="/contacts#form">Обсудить задачу <%- include('partials/icon', { name: 'arrow' }) %></a>
      </div>
    </div>
  </div>
</section>
<%- include('partials/foot') %>
