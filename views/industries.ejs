<%- include('partials/head') %>
<%- include('partials/page-hero', { heading: 'Отраслевые решения', eyebrow: '', crumbs: [{ label: 'Отрасли' }], lead: 'Подбираем конфигурацию 1С под отрасль. Базовый контур для всех: 1С:Бухгалтерия для Казахстана и 1С:ЗУП.' }) %>

<section class="section section-tight">
  <div class="container">
    <div class="tabs tabs-industries" data-tabs>
      <div class="tab-list" role="tablist" aria-label="Отрасли">
        <% industrySolutions.forEach(function (s, i) { %>
          <button class="tab" role="tab" id="tab-ind-<%= i %>" aria-controls="panel-ind-<%= i %>" aria-selected="<%= i === 0 %>" tabindex="<%= i === 0 ? 0 : -1 %>">
            <span class="tab-text"><strong><%= s.name %></strong><span><%= s.config %></span></span>
          </button>
        <% }) %>
      </div>
      <% industrySolutions.forEach(function (s, i) {
           var ind = industries.find(function (x) { return x.name === s.caseIndustry; }); %>
        <div class="tab-panel ind-panel" role="tabpanel" id="panel-ind-<%= i %>" aria-labelledby="tab-ind-<%= i %>" <%= i === 0 ? '' : 'hidden' %>>
          <div class="ind-img"><img src="<%= s.image %>" alt="" loading="lazy"></div>
          <div class="ind-info">
            <span class="chip chip-accent"><%= s.config %></span>
            <h2><%= s.name %></h2>
            <dl class="facts">
              <div><dt>Что автоматизируем</dt><dd><%= s.what %></dd></div>
              <div><dt>Что видит владелец</dt><dd class="result">→ <%= s.result %></dd></div>
            </dl>
            <div class="panel-actions">
              <a class="btn btn-primary btn-sm" href="/audit">Аудит 1С для отрасли</a>
              <% if (ind) { %><a class="link-arrow" href="/cases?industry=<%= ind.slug %>">Кейсы отрасли</a><% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="config-row">
      <span class="strip-label">Также работаем</span>
      <div class="chips"><% otherIndustries.forEach(function (x) { %><span class="chip"><%= x %></span><% }) %></div>
    </div>
  </div>
</section>
<%- include('partials/foot') %>
