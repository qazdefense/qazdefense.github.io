<%- include('partials/head') %>
<% var arrow = include('partials/icon', { name: 'arrow' }); var check = include('partials/icon', { name: 'check' }); %>

<section class="ph sol-hero">
  <div class="container sol-hero-grid">
    <div>
      <nav class="crumbs" aria-label="Навигация">
        <a href="/">Главная</a><span>/</span><a href="/solutions">Решения</a><span>/</span><a href="/solutions/programs">Наши программы</a><span>/</span><span><%= p.name %></span>
      </nav>
      <h1><%= p.name %></h1>
      <p class="ph-lead"><%= p.lead %></p>
      <div class="ph-actions">
        <a class="btn btn-cta btn-lg" href="/solutions/<%= p.slug %>/roadmap">Дорожная карта <%- arrow %></a>
        <a class="link-arrow link-light" href="/contacts#form">Хочу попробовать первым</a>
      </div>
    </div>
    <div class="sol-mock" aria-hidden="true">
      <div class="sm-bar"><i></i><i></i><i></i><span>Базовод: обновление</span></div>
      <div class="sm-body">
        <div class="sm-nav"><span>Сводка</span><span>Базы</span><span>Хранилища</span><span class="on">Обновление</span><span>Расписание</span><span>Релизы</span></div>
        <div class="sm-main">
          <div class="sm-head"><div><strong>Ночное обновление</strong><span>9 баз, 4 потока</span></div><em class="sm-pill">идёт</em></div>
          <div class="sm-rows">
            <div class="sm-row sm-th"><span>База</span><span>Шаг</span><span>Итог</span></div>
            <div class="sm-row"><span>Бухгалтерия</span><span class="pm-step">копия</span><span class="wait">идёт</span></div>
            <div class="sm-row"><span>Торговля</span><span class="pm-step">обновлена</span><span class="ok">готово</span></div>
            <div class="sm-row"><span>Зарплата</span><span class="pm-step">сеансы</span><span class="wait">ждёт 2</span></div>
            <div class="sm-row"><span>Документооборот</span><span class="pm-step">без изменений</span><span class="ok">готово</span></div>
          </div>
          <div class="sm-foot"><div><span>Готово</span><strong>3 из 9 баз</strong></div><div><span>Копии перед обновлением</span><strong>все сделаны</strong></div></div>
        </div>
      </div>
    </div>
  </div>
  <div class="container">
    <dl class="sol-facts">
      <% p.facts.forEach(function (f) { %><div><dt><%= f.k %></dt><dd><%= f.v %></dd></div><% }) %>
    </dl>
  </div>
</section>

<section class="pg sol-sec band-white">
  <div class="container">
    <div class="pg-head"><h2>Как Базовод обновляет одну базу</h2></div>
    <ol class="pm-flow">
      <% p.flow.forEach(function (f, i) { %><li><span class="pm-n"><%= i + 1 %></span><div><strong><%= f.t %></strong><span><%= f.x %></span></div></li><% }) %>
    </ol>
    <p class="pm-fail"><%= p.fail %></p>
  </div>
</section>

<% if (rm && rm.current) { var first = rm.milestones.find(function (m) { return m.version === '0.2'; }) || rm.current; %>
<section class="pg sol-sec band-light">
  <div class="container sol-two">
    <div>
      <div class="pg-head"><h2>Что войдёт в первую версию</h2></div>
      <p class="pm-sub">Этап <%= first.version %>. Сделано <%= first.done %> из <%= first.total %>.</p>
      <ul class="pm-items pm-first">
        <% first.items.forEach(function (it) { %>
          <li class="<%= it.done ? 'is-done' : '' %>"><span class="pm-box"><% if (it.done) { %><%- check %><% } %></span><span><strong><%= it.title %></strong><span class="pm-note"><%= it.note %></span></span></li>
        <% }) %>
      </ul>
    </div>
    <div>
      <div class="pg-head"><h2>Дорожная карта</h2></div>
      <p class="pm-sub">Сделано <%= rm.done %> из <%= rm.total %> задач. Обновлено <%= rm.updatedText %>.</p>
      <ol class="pm-stages">
        <% rm.milestones.forEach(function (m) { %>
          <li class="is-<%= m.status %>">
            <span class="pm-v"><%= m.version %></span>
            <span class="pm-t"><%= m.title %></span>
            <span class="pm-s"><%= m.status === 'done' ? 'сделано' : m.status === 'next' ? 'в работе' : 'впереди' %></span>
          </li>
        <% }) %>
      </ol>
      <a class="link-arrow" href="/solutions/<%= p.slug %>/roadmap">Все задачи по этапам</a>
    </div>
  </div>
</section>
<% } %>

<section class="pg sol-sec band-yellow">
  <div class="container">
    <div class="pg-head"><h2>Кому пригодится</h2></div>
    <div class="pm-aud">
      <% p.audience.forEach(function (a) { %><div><h3><%= a.t %></h3><p><%= a.x %></p></div><% }) %>
    </div>
    <a class="cta-bar" href="/contacts#form">
      <span class="cta-bar-text"><strong>Хотите получить Базовод первыми?</strong>Оставьте контакты, пришлём первую версию и поможем настроить</span>
      <span class="btn btn-cta">Оставить заявку <%- arrow %></span>
    </a>
  </div>
</section>
<%- include('partials/foot') %>
